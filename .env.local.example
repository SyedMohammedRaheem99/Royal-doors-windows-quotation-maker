# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# MongoDB Atlas connection string (free M0 tier is fine).
# Atlas dashboard -> Database -> Connect -> Drivers -> copy the connection string,
# then replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=royal_quote

# NextAuth — generate a random secret: `openssl rand -base64 32`
# Use a FRESH value in production; never reuse the development secret.
AUTH_SECRET=

# Production only. The canonical public origin, e.g. https://quotes.royaldoorsandwindows.com
# Auth.js builds its sign-in callback URLs from this. auth.config.ts sets
# trustHost:true which usually infers it, but behind a proxy/CDN the inferred
# host can be wrong and login then redirects to the wrong origin. Leave unset
# for local development.
AUTH_URL=
