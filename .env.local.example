# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# MongoDB Atlas connection string (free M0 tier is fine).
# Atlas dashboard -> Database -> Connect -> Drivers -> copy the connection string,
# then replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=royal_quote

# NextAuth — generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=
